<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <include domain="database" path="napect.db" />
    <include domain="file" path="photos/" />
    <include domain="sharedpref" path="user_prefs.xml" />
    <!-- Exclude encrypted prefs containing the OpenAI API key — must not leave the device -->
    <exclude domain="sharedpref" path="napect_secure_prefs.xml" />
    <exclude domain="sharedpref" path="napect_secure_prefs_fallback.xml" />
</full-backup-content>